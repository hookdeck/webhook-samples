            "transcript": {
              "created_at": "2025-07-17T20:05:56+00:00",
              "hashed_id": "htb93bq6g79crsvk",
              "language_name": "Arabic (Iraq)",
              "native_language_name": "\u0627\u0644\u0639\u0631\u0628\u064a\u0629 (\u0627\u0644\u0639\u0631\u0627\u0642)",
              "text": "\u062d\u0633\u0646\u0627. \u0647\u0630\u0627 \u0645\u0627 \u0623\u062a\u062d\u062f\u062b \u0639\u0646\u0647 \u0627\u0644\u0622\u0646. \u0623\u062d\u0627\u0648\u0644 \u0623\u0646 \u0623\u062d\u062f\u062f \u0645\u0634\u0643\u0644\u0629 \u0642\u064a\u062b\u0627\u0631\u064a.\n\n\u0644\u0630\u0644\u0643 \u0625\u0630\u0627 \u0644\u0639\u0628\u062a \u0641\u064a \u0627\u0644\u062d\u0627\u062f\u064a \u0639\u0634\u0631 \u0648\u0627\u0644\u062b\u0627\u0646\u064a \u0639\u0634\u0631 \u0648\u0627\u0644\u062b\u0627\u0644\u062b \u0639\u0634\u0631 \u0648\u0627\u0644\u0631\u0627\u0628\u0639 \u0639\u0634\u0631\u060c \u0641\u0644\u0646 \u064a\u0643\u0648\u0646 \u0647\u0646\u0627\u0643 \u0623\u064a \u0636\u062c\u064a\u062c. \u0648\u0644\u0643\u0646 \u0625\u0630\u0627 \u0628\u062f\u0623\u062a \u0641\u064a \u0627\u0644\u0627\u0646\u062d\u0646\u0627\u0621\u060c \u0641\u0628\u0645\u062c\u0631\u062f \u0623\u0646 \u0623\u0642\u0648\u0645 \u0628\u0627\u0644\u0627\u0646\u062d\u0646\u0627\u0621 \u0627\u0644\u062b\u0627\u0644\u062b \u0639\u0634\u0631 \u0647\u0646\u0627\u060c \u0633\u064a\u062e\u062a\u0646\u0642 \u0627\u0644\u0623\u0645\u0631. \u0648\u0646\u0641\u0633 \u0627\u0644\u0627\u0646\u062d\u0646\u0627\u0621 \u0639\u0644\u0649 \u0627\u0644\u0642\u062f\u0645 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0639\u0634\u0631\u0629 \u062c\u064a\u062f.\n\n\u0631\u0628\u0645\u0627 \u0627\u0644\u0642\u0644\u064a\u0644 \u0645\u0646 \u0627\u0644\u0636\u062c\u064a\u062c\u060c \u0644\u0643\u0646 \u0644\u064a\u0633 \u0643\u0627\u0641\u064a\u064b\u0627 \u0644\u064a\u0643\u0648\u0646 \u0645\u0634\u0643\u0644\u0629 \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u064a. \u0648\u0646\u0641\u0633 \u0627\u0644\u0634\u064a\u0621 \u0645\u0639 \u0627\u0644\u062d\u0646\u0642 \u0627\u0644\u0631\u0627\u0628\u0639 \u0639\u0634\u0631.\n\n\u0627\u0644\u0642\u0644\u064a\u0644 \u0645\u0646 \u0627\u0644\u0636\u062c\u064a\u062c.\n\n\u0648\u0628\u0639\u062f \u0630\u0644\u0643\u060c \u0644\u0627 \u0628\u0623\u0633. \u0644\u0627 \u0623\u0632\u064a\u0632. \u0648\u0627\u0644\u0642\u0644\u064a\u0644 \u0645\u0646 \u0627\u0644\u0636\u062c\u064a\u062c \u0644\u0627 \u0628\u0623\u0633 \u0628\u0647\u060c \u0644\u0643\u0646 \u0627\u0644\u0627\u062e\u062a\u0646\u0627\u0642 \u0623\u0645\u0631 \u0645\u0624\u0633\u0641 \u0628\u0639\u0636 \u0627\u0644\u0634\u064a\u0621.\n\n\u064a\u0628\u062f\u0648 \u0627\u0644\u0623\u0645\u0631 \u0623\u0641\u0636\u0644 \u0643\u062b\u064a\u0631\u064b\u0627 \u0641\u064a \u0627\u0644\u0633\u0644\u0633\u0644\u0629 b\u060c \u0648\u0644\u0643\u0646 \u0641\u064a \u0627\u0644\u0633\u0644\u0633\u0644\u0629 e\u060c \u064a\u0643\u0648\u0646 \u0645\u0644\u062d\u0648\u0638\u064b\u0627 \u062c\u062f\u064b\u0627.\n\n\u0648\u064a\u0645\u0643\u0646\u0643 \u0633\u0645\u0627\u0639 \u0630\u0644\u0643 \u062a\u0642\u0631\u064a\u0628\u064b\u0627\u060c \u0645\u062b\u0644 \u0627\u0644\u0627\u0646\u062e\u0631\u0627\u0637 \u0641\u064a \u063a\u0636\u0628 \u0622\u062e\u0631.\n\n\u0625\u0630\u0646\u060c \u0647\u0630\u0647 \u0647\u064a \u0627\u0644\u0645\u0634\u0643\u0644\u0629.",
              "updated_at": "2025-07-17T20:05:57+00:00"
