# Copy to scripts/scrapfly/.env.local (preferred) or .env.local at the
# repo root, and fill in. Either path is gitignored.

# Hookdeck project API key — https://dashboard.hookdeck.com/settings/project/secrets
HOOKDECK_API_KEY=

# Scrapfly API key — https://scrapfly.io/dashboard
# A test-tier key is fine; each capture spends ~1 credit per product.
SCRAPFLY_API_KEY=

# The name of the webhook you register in the Scrapfly dashboard during setup.
# Used as the `webhook_name` query param on Scrapfly API calls.
SCRAPFLY_WEBHOOK_NAME=samples-capture

# The Hookdeck source name (idempotently created by `yarn setup:scrapfly`).
HOOKDECK_SOURCE_NAME=scrapfly
